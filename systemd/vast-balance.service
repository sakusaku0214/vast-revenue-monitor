[Unit]
Description=Vast Revenue Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vast-revenue-monitor
Group=vast-revenue-monitor
WorkingDirectory=/opt/vast-revenue-monitor
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/vast-revenue-monitor/.venv/bin/python /opt/vast-revenue-monitor/balance.py --config /opt/vast-revenue-monitor/config.json
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vast-revenue-monitor/state /opt/vast-revenue-monitor/logs

[Install]
WantedBy=multi-user.target
